# ======================================================
# MaxFunded Prop Firm - Backend Environment Configuration
# ======================================================
# Copy this file to .env and fill in your real values.

ENVIRONMENT=development
APP_NAME="MaxFunded Prop Firm"
SECRET_KEY=maxfunded-secret-key-change-this-in-production-32chars!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite+aiosqlite:///./riffmax.db
DATABASE_URL_SYNC=sqlite:///./riffmax.db
REDIS_URL=redis://localhost:6379/0

# Compliance & Currencies
DEFAULT_CURRENCY=USD
SUPPORTED_COUNTRIES=US,GB,CA,DE,FR,NG,ZA,AE,SG,AU,GH,KE,IN,PK,PH,MY
RESTRICTED_COUNTRIES=IR,KP,SY,CU,RU,BY
KYC_REQUIRED_COUNTRIES=US,NG,GB

# URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# NowPayments (Crypto)
# Get from: https://nowpayments.io/merchant-dashboard -> Settings -> API Keys
NOWPAYMENTS_API_KEY=YOUR_NOWPAYMENTS_API_KEY_HERE
NOWPAYMENTS_IPN_SECRET=YOUR_NOWPAYMENTS_IPN_SECRET_HERE
NOWPAYMENTS_SANDBOX=false

# Stripe (optional, skip for now)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal (optional)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=

# Flutterwave (optional)
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_SECRET_HASH=

# Paystack (optional)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Bank Wire Transfer
BANK_TRANSFER_ENABLED=true
BANK_NAME=MaxFunded Operations
BANK_ACCOUNT_NAME=MaxFunded Technologies Ltd
BANK_ACCOUNT_NUMBER=YOUR_ACCOUNT_NUMBER_HERE
BANK_SWIFT_BIC=YOUR_SWIFT_BIC_HERE
BANK_IBAN=
BANK_ROUTING=
BANK_CURRENCY=USD
BANK_INSTRUCTIONS=Include your unique reference code in the transfer memo. Processing takes 1-3 business days.

# Email / SMTP
# Brevo FREE (300 emails/day): smtp-relay.brevo.com:587
# Gmail FREE (500/day): smtp.gmail.com:587 with App Password
# Resend FREE (3000/month): smtp.resend.com:465, user=resend
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=support@maxfunded.com
SMTP_FROM_NAME=MaxFunded Prop Firm
SMTP_TLS=true

# MT5 Bridge
MT5_CHALLENGE_SERVER=MaxFunded-Server1
MT5_LIVE_SERVER=MaxFunded-Live1
MT5_BRIDGE_SECRET=change-me-in-production-32chars-secure
MT5_MANAGER_HOST=
MT5_MANAGER_PORT=443
MT5_MANAGER_LOGIN=0
MT5_MANAGER_PASSWORD=
