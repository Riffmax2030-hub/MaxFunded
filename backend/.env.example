ENVIRONMENT=development
APP_NAME="RiffMax Funding"
SECRET_KEY=riffmax-secret-key-production-change-32-chars-long!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
# Default to SQLite for easy immediate local running without external server setup
DATABASE_URL=sqlite+aiosqlite:///./riffmax.db
DATABASE_URL_SYNC=sqlite:///./riffmax.db

# In Docker / Production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/riffmax_prop
# DATABASE_URL_SYNC=postgresql://postgres:postgrespassword@localhost:5432/riffmax_prop

REDIS_URL=redis://localhost:6379/0

# Compliance Defaults
DEFAULT_CURRENCY=USD
SUPPORTED_COUNTRIES=US,GB,CA,DE,FR,NG,ZA,AE,SG,AU
RESTRICTED_COUNTRIES=IR,KP,SY,CU,RU,BY
KYC_REQUIRED_COUNTRIES=US,NG,GB
